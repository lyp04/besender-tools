{
  "manifest_version": 3,
  "name": "BESENDER 良品/不良品聚合统计",
  "version": "1.2.3",
  "description": "在型号列表页勾选多个型号汇总良品/不良品/总和；在型号详情页一键查看当日/区间统计。中国时间自动换算为本地时区。",
  "author": "YupengLai",

  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://bms.besender.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "csp-relaxation",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },

  "content_scripts": [
    {
      "matches": ["https://bms.besender.com/bsd-warehouse/*"],
      "js": ["bootstrap.js"],
      "run_at": "document_idle"
    }
  ]
}
